# Copy to .env. Never commit real credentials.
DB_URL=jdbc:mysql://127.0.0.1:3306/okx_pilot?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USER=okx_pilot
DB_PASSWORD=
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
# Base64 encoded 32 random bytes. Keep stable and back it up separately from MySQL.
PILOT_MASTER_KEY=
PILOT_SESSION_HOURS=168
# Credentials are entered per user inside the app, not as global environment variables.
# Default model: gpt-6-luna; enter your NX_API_KEY value in the app's AI key field.
AI_ALLOWED_BASE_URLS=https://nxaiapp.com/v1,https://api.openai.com/v1,https://api.deepseek.com/v1,https://openrouter.ai/api/v1
